<%= form_with model: [:super_admin, @clinic], local: true do |form| %>
  <div class="mb-3">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :email %>
    <%= form.email_field :email, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :phone %>
    <%= form.telephone_field :phone, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :address %>
    <%= form.text_area :address, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :registration_number %>
    <%= form.text_field :registration_number, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :status %>
    <%= form.text_field :status, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :subscription_plan %>
    <%= form.text_field :subscription_plan, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
